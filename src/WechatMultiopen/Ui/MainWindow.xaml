<Window x:Class="WechatMultiopen.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微信多开助手" Height="420" Width="680" MinHeight="360" MinWidth="560">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="微信多开助手" FontSize="26" FontWeight="SemiBold" />
    <Grid Grid.Row="1" Margin="0,20,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="72" />
        <ColumnDefinition Width="22" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="要打开的微信数量" VerticalAlignment="Center" />
      <TextBox x:Name="CountTextBox"
               Grid.Column="1"
               Margin="16,0,4,0"
               Height="30"
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Center"
               Text="2"
               MaxLength="1"
               PreviewTextInput="CountTextBox_PreviewTextInput"
               PreviewKeyDown="CountTextBox_PreviewKeyDown"
               LostFocus="CountTextBox_LostFocus" />
      <Grid Grid.Column="2" Height="30" Margin="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="15" />
          <RowDefinition Height="15" />
        </Grid.RowDefinitions>
        <Button x:Name="IncreaseButton"
                Grid.Row="0"
                Padding="0"
                Margin="0"
                FontSize="9"
                Content="▲"
                ToolTip="增加实例数量"
                Click="IncreaseButton_Click" />
        <Button x:Name="DecreaseButton"
                Grid.Row="1"
                Padding="0"
                Margin="0"
                FontSize="9"
                Content="▼"
                ToolTip="减少实例数量"
                Click="DecreaseButton_Click" />
      </Grid>
    </Grid>
    <TextBlock x:Name="WechatText" Grid.Row="2" Text="正在检测微信..." TextWrapping="Wrap" />
    <Border Grid.Row="3" Margin="0,16,0,16" BorderBrush="#B8C2CC" BorderThickness="1" Padding="4">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="DoctorButton" Content="自检" Click="DoctorButton_Click" />
      <Button x:Name="LaunchButton" Content="启动实例" Click="LaunchButton_Click" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
