<Window x:Class="WechatMultiopen.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="微信多开助手"
        Width="680" Height="560"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F9"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        Icon="/Assets/app.ico"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#07C160" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#06AD56" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#059149" />
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#A9DFC0" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E6EAF0" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2329" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7480" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9AA3AE" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D5DBE3" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#EEF1F5" />
    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#E7F7EE" />
    <SolidColorBrush x:Key="PillTextBrush" Color="#07915A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E81123" />
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18,16" />
    </Style>

    <Style x:Key="CaptionButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="BackgroundBorder" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="#E4E8ED" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="#D8DDE3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="BackgroundBorder" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource DangerBrush}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="26,9" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="BackgroundBorder"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource AccentPressedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource AccentDisabledBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="20,8" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="BackgroundBorder"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource ControlHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="#E2E6EB" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StepperButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="BackgroundBorder"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource ControlHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="#E2E6EB" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CountTextBoxStyle" TargetType="TextBox">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="38" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MaxLength" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="BackgroundBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
              <ScrollViewer x:Name="PART_ContentHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="#B9C2CC" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PillBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PillBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 标题栏 -->
    <Grid Grid.Row="0" Background="Transparent">
      <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
        <Image Source="/Assets/app.ico" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="微信多开助手"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="9,0,0,0"
                   VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click"
                ToolTip="最小化">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE921;" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
        </Button>
        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}" Click="CloseButton_Click"
                ToolTip="关闭">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8BB;" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- 内容区 -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,4,28,0">
      <StackPanel>
        <!-- 头部 -->
        <StackPanel Orientation="Horizontal" Margin="0,6,0,18">
          <Image Source="/Assets/app.ico" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"
                 VerticalAlignment="Center" />
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="微信多开助手"
                         FontSize="22"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <Border Style="{StaticResource PillBorderStyle}" Margin="10,1,0,0">
                <TextBlock x:Name="VersionText" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource PillTextBrush}" Text="v1.1.0" />
              </Border>
            </StackPanel>
            <TextBlock Text="一台电脑，同时在线多个微信 · 仅本机操作，不读取聊天内容"
                       FontSize="12.5"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="1,5,0,0" />
          </StackPanel>
        </StackPanel>

        <!-- 微信程序信息 -->
        <Border Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="微信程序" FontSize="11.5" FontWeight="SemiBold"
                         Foreground="{StaticResource TextTertiaryBrush}" />
              <TextBlock x:Name="WechatText" Text="正在检测微信..." FontSize="13"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Margin="0,6,0,0" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Border x:Name="VersionChip" Style="{StaticResource PillBorderStyle}">
                  <TextBlock x:Name="VersionChipText" FontSize="11.5" Foreground="{StaticResource PillTextBrush}" />
                </Border>
                <Border x:Name="RunningChip" Style="{StaticResource PillBorderStyle}" Margin="8,0,0,0">
                  <TextBlock x:Name="RunningChipText" FontSize="11.5" Foreground="{StaticResource PillTextBrush}" />
                </Border>
              </StackPanel>
            </StackPanel>
            <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                    Content="更换路径" FontSize="12.5" Padding="14,6" Margin="12,0,0,0"
                    VerticalAlignment="Top" Click="BrowseButton_Click"
                    ToolTip="微信未在默认位置安装时，手动选择 WeChat.exe / Weixin.exe" />
          </Grid>
        </Border>

        <!-- 实例数量 -->
        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
          <StackPanel>
            <Grid>
              <TextBlock Text="要打开的微信数量" FontSize="13" FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBlock Text="范围 2 ~ 4" FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}"
                         HorizontalAlignment="Right" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="DecreaseButton" Style="{StaticResource StepperButtonStyle}" Click="DecreaseButton_Click"
                      ToolTip="减少实例数量">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE949;" FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}" />
              </Button>
              <TextBox x:Name="CountTextBox" Style="{StaticResource CountTextBoxStyle}" Margin="8,0"
                       Text="2"
                       PreviewTextInput="CountTextBox_PreviewTextInput"
                       PreviewKeyDown="CountTextBox_PreviewKeyDown"
                       LostFocus="CountTextBox_LostFocus" />
              <Button x:Name="IncreaseButton" Style="{StaticResource StepperButtonStyle}" Click="IncreaseButton_Click"
                      ToolTip="增加实例数量">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE948;" FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 状态输出 -->
        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="运行状态" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextTertiaryBrush}" />
            <ScrollViewer MaxHeight="120" Margin="0,8,0,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
              <TextBlock x:Name="StatusText" FontSize="12.5" LineHeight="20"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         TextWrapping="Wrap"
                         Text="准备就绪。点击「自检」查看环境信息，点击「启动实例」开始多开。" />
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,18">
          <Button x:Name="DoctorButton" Style="{StaticResource SecondaryButtonStyle}" Content="自检" Margin="0"
                  Click="DoctorButton_Click" />
          <Button x:Name="LaunchButton" Style="{StaticResource PrimaryButtonStyle}" Content="启动实例"
                  IsDefault="True" Click="LaunchButton_Click" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- 合规声明 -->
    <Border Grid.Row="2" Background="Transparent" Padding="28,0,28,12">
      <TextBlock FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                 TextWrapping="Wrap" LineHeight="16"
                 Text="本工具仅操作本机进程句柄，不修改微信文件、不读取聊天内容、不涉及通信协议或自动化功能。请仅用于合法的个人多账号办公，并遵守微信软件许可及服务协议。" />
    </Border>
  </Grid>
</Window>
